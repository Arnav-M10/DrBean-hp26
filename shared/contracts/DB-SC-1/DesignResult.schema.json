{
  "$defs": {
    "ArtifactReference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "byte_size": {
          "maximum": 4194304,
          "minimum": 1,
          "title": "Byte Size",
          "type": "integer"
        },
        "media_type": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "sha256",
        "byte_size",
        "media_type"
      ],
      "title": "ArtifactReference",
      "type": "object"
    },
    "DesignOption": {
      "additionalProperties": false,
      "properties": {
        "time": {
          "maxLength": 514,
          "pattern": "^(?:0|-[1-9][0-9]*|[1-9][0-9]*)/[1-9][0-9]*$",
          "title": "Time",
          "type": "string"
        },
        "state": {
          "enum": [
            "evaluated",
            "skipped",
            "failed",
            "unavailable"
          ],
          "title": "State",
          "type": "string"
        },
        "reason_code": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Reason Code",
          "type": "string"
        },
        "exact_margin": {
          "anyOf": [
            {
              "maxLength": 514,
              "pattern": "^(?:0|-[1-9][0-9]*|[1-9][0-9]*)/[1-9][0-9]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exact Margin"
        }
      },
      "required": [
        "time",
        "state",
        "reason_code"
      ],
      "title": "DesignOption",
      "type": "object"
    },
    "VerificationRecord": {
      "additionalProperties": false,
      "properties": {
        "checker_name": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Checker Name",
          "type": "string"
        },
        "checker_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Checker Version",
          "type": "string"
        },
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Sha256",
          "type": "string"
        },
        "proposition": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Proposition",
          "type": "string"
        },
        "verification": {
          "enum": [
            "not_checked",
            "valid",
            "invalid",
            "inconclusive",
            "unsupported",
            "failed"
          ],
          "title": "Verification",
          "type": "string"
        },
        "expected_binding": {
          "enum": [
            "matches",
            "mismatch",
            "not_supplied"
          ],
          "title": "Expected Binding",
          "type": "string"
        },
        "expected_problem_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Expected Problem Digest",
          "type": "string"
        },
        "observed_problem_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Problem Digest"
        }
      },
      "required": [
        "checker_name",
        "checker_version",
        "artifact_id",
        "artifact_sha256",
        "proposition",
        "verification",
        "expected_binding",
        "expected_problem_digest"
      ],
      "title": "VerificationRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "design_tier": {
      "enum": [
        "numerical_guidance",
        "checked_pair_separation",
        "no_separation_established",
        "unavailable"
      ],
      "title": "Design Tier",
      "type": "string"
    },
    "verification": {
      "enum": [
        "not_checked",
        "valid",
        "invalid",
        "inconclusive",
        "unsupported",
        "failed"
      ],
      "title": "Verification",
      "type": "string"
    },
    "replay": {
      "enum": [
        "not_run",
        "running",
        "passed",
        "failed",
        "unsupported"
      ],
      "title": "Replay",
      "type": "string"
    },
    "reason_code": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Reason Code",
      "type": "string"
    },
    "selected_time": {
      "anyOf": [
        {
          "maxLength": 514,
          "pattern": "^(?:0|-[1-9][0-9]*|[1-9][0-9]*)/[1-9][0-9]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selected Time"
    },
    "options": {
      "items": {
        "$ref": "#/$defs/DesignOption"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Options",
      "type": "array"
    },
    "algorithm": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Algorithm"
    },
    "candidate_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
        "type": "string"
      },
      "maxItems": 2,
      "title": "Candidate Ids",
      "type": "array"
    },
    "future_hard_allowance": {
      "anyOf": [
        {
          "maxLength": 514,
          "pattern": "^(?:0|-[1-9][0-9]*|[1-9][0-9]*)/[1-9][0-9]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Future Hard Allowance"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactReference"
      },
      "maxItems": 16,
      "title": "Artifacts",
      "type": "array"
    },
    "verification_record": {
      "anyOf": [
        {
          "$ref": "#/$defs/VerificationRecord"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "design_tier",
    "verification",
    "replay",
    "reason_code",
    "options"
  ],
  "title": "DesignResult",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dr-bean:DB-SC-1:DesignResult"
}
