{
  "additionalProperties": false,
  "properties": {
    "code": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Code",
      "type": "string"
    },
    "message": {
      "maxLength": 2000,
      "title": "Message",
      "type": "string"
    },
    "field_paths": {
      "items": {
        "type": "string"
      },
      "maxItems": 50,
      "title": "Field Paths",
      "type": "array"
    },
    "retryable": {
      "default": false,
      "title": "Retryable",
      "type": "boolean"
    },
    "current_revision_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Current Revision Id"
    },
    "request_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Request Id",
      "type": "string"
    }
  },
  "required": [
    "code",
    "message",
    "request_id"
  ],
  "title": "ApiError",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dr-bean:DB-SC-1:ApiError"
}
