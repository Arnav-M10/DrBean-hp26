{
  "$defs": {
    "DatasetBody": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "DB-SC-1",
          "default": "DB-SC-1",
          "title": "Schema Version",
          "type": "string"
        },
        "experiment_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Experiment Id",
          "type": "string"
        },
        "time_origin": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Time Origin",
          "type": "string"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/ObservationRow"
          },
          "maxItems": 500,
          "minItems": 1,
          "title": "Rows",
          "type": "array"
        },
        "parent_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Id"
        },
        "change_reason": {
          "maxLength": 2000,
          "title": "Change Reason",
          "type": "string"
        },
        "origin": {
          "enum": [
            "actual",
            "hypothetical",
            "synthetic"
          ],
          "title": "Origin",
          "type": "string"
        }
      },
      "required": [
        "experiment_id",
        "time_origin",
        "rows",
        "change_reason",
        "origin"
      ],
      "title": "DatasetBody",
      "type": "object"
    },
    "MaterializedProblemInputs": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "const": "two_rate_concentration",
          "default": "two_rate_concentration",
          "title": "Model",
          "type": "string"
        },
        "domain": {
          "$ref": "#/$defs/ParameterDomain"
        },
        "initial_concentration": {
          "const": "0/1",
          "default": "0/1",
          "title": "Initial Concentration",
          "type": "string"
        },
        "observable": {
          "const": "concentration",
          "default": "concentration",
          "title": "Observable",
          "type": "string"
        },
        "time_unit": {
          "const": "h",
          "default": "h",
          "title": "Time Unit",
          "type": "string"
        },
        "concentration_unit": {
          "const": "mg/L",
          "default": "mg/L",
          "title": "Concentration Unit",
          "type": "string"
        },
        "rate_unit": {
          "const": "1/h",
          "default": "1/h",
          "title": "Rate Unit",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/TargetInterval"
        }
      },
      "required": [
        "domain",
        "target"
      ],
      "title": "MaterializedProblemInputs",
      "type": "object"
    },
    "ObservationRow": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Id",
          "type": "string"
        },
        "time": {
          "maxLength": 514,
          "pattern": "^(?:0|-[1-9][0-9]*|[1-9][0-9]*)/[1-9][0-9]*$",
          "title": "Time",
          "type": "string"
        },
        "concentration": {
          "maxLength": 514,
          "pattern": "^(?:0|-[1-9][0-9]*|[1-9][0-9]*)/[1-9][0-9]*$",
          "title": "Concentration",
          "type": "string"
        },
        "hard_allowance": {
          "maxLength": 514,
          "pattern": "^(?:0|-[1-9][0-9]*|[1-9][0-9]*)/[1-9][0-9]*$",
          "title": "Hard Allowance",
          "type": "string"
        },
        "included": {
          "title": "Included",
          "type": "boolean"
        },
        "original_values": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 12,
          "title": "Original Values",
          "type": "object"
        },
        "source_asset_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Asset Id"
        },
        "notes": {
          "default": "",
          "maxLength": 2000,
          "title": "Notes",
          "type": "string"
        }
      },
      "required": [
        "id",
        "time",
        "concentration",
        "hard_allowance",
        "included"
      ],
      "title": "ObservationRow",
      "type": "object"
    },
    "ParameterBounds": {
      "additionalProperties": false,
      "properties": {
        "lower": {
          "maxLength": 514,
          "pattern": "^(?:0|-[1-9][0-9]*|[1-9][0-9]*)/[1-9][0-9]*$",
          "title": "Lower",
          "type": "string"
        },
        "upper": {
          "maxLength": 514,
          "pattern": "^(?:0|-[1-9][0-9]*|[1-9][0-9]*)/[1-9][0-9]*$",
          "title": "Upper",
          "type": "string"
        }
      },
      "required": [
        "lower",
        "upper"
      ],
      "title": "ParameterBounds",
      "type": "object"
    },
    "ParameterDomain": {
      "additionalProperties": false,
      "properties": {
        "A": {
          "$ref": "#/$defs/ParameterBounds"
        },
        "ke": {
          "$ref": "#/$defs/ParameterBounds"
        },
        "ka": {
          "$ref": "#/$defs/ParameterBounds"
        },
        "rate_order": {
          "const": "ke_lt_ka",
          "default": "ke_lt_ka",
          "title": "Rate Order",
          "type": "string"
        }
      },
      "required": [
        "A",
        "ke",
        "ka"
      ],
      "title": "ParameterDomain",
      "type": "object"
    },
    "TargetInterval": {
      "additionalProperties": false,
      "properties": {
        "parameter": {
          "const": "ke",
          "default": "ke",
          "title": "Parameter",
          "type": "string"
        },
        "lower": {
          "maxLength": 514,
          "pattern": "^(?:0|-[1-9][0-9]*|[1-9][0-9]*)/[1-9][0-9]*$",
          "title": "Lower",
          "type": "string"
        },
        "upper": {
          "maxLength": 514,
          "pattern": "^(?:0|-[1-9][0-9]*|[1-9][0-9]*)/[1-9][0-9]*$",
          "title": "Upper",
          "type": "string"
        },
        "closed": {
          "const": true,
          "default": true,
          "title": "Closed",
          "type": "boolean"
        }
      },
      "required": [
        "lower",
        "upper"
      ],
      "title": "TargetInterval",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "expected_review_digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Expected Review Digest",
      "type": "string"
    },
    "dataset": {
      "$ref": "#/$defs/DatasetBody"
    },
    "problem": {
      "$ref": "#/$defs/MaterializedProblemInputs"
    },
    "human_assumptions": {
      "additionalProperties": {
        "maxLength": 2000,
        "minLength": 1,
        "type": "string"
      },
      "maxProperties": 50,
      "title": "Human Assumptions",
      "type": "object"
    }
  },
  "required": [
    "expected_review_digest",
    "dataset",
    "problem"
  ],
  "title": "MaterializeIntakeRequest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dr-bean:DB-SC-1:MaterializeIntakeRequest"
}
