{
  "$defs": {
    "ProviderConsent": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "const": "gemini",
          "default": "gemini",
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "source_asset_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "maxItems": 1,
          "title": "Source Asset Ids",
          "type": "array"
        },
        "include_notes": {
          "title": "Include Notes",
          "type": "boolean"
        },
        "include_existing_values": {
          "title": "Include Existing Values",
          "type": "boolean"
        },
        "accepted": {
          "const": true,
          "title": "Accepted",
          "type": "boolean"
        }
      },
      "required": [
        "model",
        "include_notes",
        "include_existing_values",
        "accepted"
      ],
      "title": "ProviderConsent",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "operation": {
      "enum": [
        "interpret_design",
        "interpret_observation",
        "explain"
      ],
      "title": "Operation",
      "type": "string"
    },
    "client_operation_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Client Operation Id",
      "type": "string"
    },
    "expected_conversation_revision": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "title": "Expected Conversation Revision",
      "type": "integer"
    },
    "problem_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Problem Id"
    },
    "run_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "suggestion_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Suggestion Id"
    },
    "text": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Text",
      "type": "string"
    },
    "source_asset_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
        "type": "string"
      },
      "maxItems": 1,
      "title": "Source Asset Ids",
      "type": "array"
    },
    "consent": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProviderConsent"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "context": {
      "additionalProperties": {
        "type": "string"
      },
      "maxProperties": 32,
      "title": "Context",
      "type": "object"
    }
  },
  "required": [
    "operation",
    "client_operation_id",
    "expected_conversation_revision",
    "text"
  ],
  "title": "AssistantTurnRequest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dr-bean:DB-SC-1:AssistantTurnRequest"
}
