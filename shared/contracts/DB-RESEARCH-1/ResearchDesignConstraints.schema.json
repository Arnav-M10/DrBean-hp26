{
  "$defs": {
    "AllowanceOrigin": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "hypothetical",
            "reviewed_hard_bound"
          ],
          "title": "Kind",
          "type": "string"
        },
        "description": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "description"
      ],
      "title": "AllowanceOrigin",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "feasible_times": {
      "items": {
        "maxLength": 514,
        "pattern": "^(?:0|-[1-9][0-9]*|[1-9][0-9]*)/[1-9][0-9]*$",
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Feasible Times",
      "type": "array"
    },
    "future_hard_allowance": {
      "maxLength": 514,
      "pattern": "^(?:0|-[1-9][0-9]*|[1-9][0-9]*)/[1-9][0-9]*$",
      "title": "Future Hard Allowance",
      "type": "string"
    },
    "maximum_horizon": {
      "maxLength": 514,
      "pattern": "^(?:0|-[1-9][0-9]*|[1-9][0-9]*)/[1-9][0-9]*$",
      "title": "Maximum Horizon",
      "type": "string"
    },
    "allowance_origin": {
      "$ref": "#/$defs/AllowanceOrigin"
    },
    "requested_tier": {
      "enum": [
        "numerical_guidance",
        "checked_pair_separation"
      ],
      "title": "Requested Tier",
      "type": "string"
    },
    "allow_construction": {
      "default": false,
      "title": "Allow Construction",
      "type": "boolean"
    },
    "allow_continuation": {
      "default": false,
      "title": "Allow Continuation",
      "type": "boolean"
    }
  },
  "required": [
    "feasible_times",
    "future_hard_allowance",
    "maximum_horizon",
    "allowance_origin",
    "requested_tier"
  ],
  "title": "ResearchDesignConstraints",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dr-bean:DB-RESEARCH-1:ResearchDesignConstraints"
}
