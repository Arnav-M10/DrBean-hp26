{
  "$defs": {
    "ResearchActionSnapshot": {
      "additionalProperties": false,
      "properties": {
        "logical_turns": {
          "minimum": 0,
          "title": "Logical Turns",
          "type": "integer"
        },
        "tool_calls": {
          "minimum": 0,
          "title": "Tool Calls",
          "type": "integer"
        },
        "child_count": {
          "minimum": 0,
          "title": "Child Count",
          "type": "integer"
        },
        "physical_calls": {
          "minimum": 0,
          "title": "Physical Calls",
          "type": "integer"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Id",
          "type": "string"
        },
        "state": {
          "title": "State",
          "type": "string"
        },
        "budget": {
          "$ref": "#/$defs/ResearchBudget"
        },
        "active_seconds": {
          "pattern": "^[0-9]+\\.[0-9]{3}$",
          "title": "Active Seconds",
          "type": "string"
        },
        "waiting_job_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Waiting Job Id"
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Error Code"
        }
      },
      "required": [
        "logical_turns",
        "tool_calls",
        "child_count",
        "physical_calls",
        "id",
        "state",
        "budget",
        "active_seconds",
        "waiting_job_id",
        "error_code"
      ],
      "title": "ResearchActionSnapshot",
      "type": "object"
    },
    "ResearchBudget": {
      "additionalProperties": false,
      "description": "Lower limits win. No allocation or scientific approval is granted here.",
      "properties": {
        "policy_version": {
          "const": "research-action.v1",
          "default": "research-action.v1",
          "title": "Policy Version",
          "type": "string"
        },
        "model_turns": {
          "default": 4,
          "maximum": 4,
          "minimum": 1,
          "title": "Model Turns",
          "type": "integer"
        },
        "tool_calls": {
          "default": 6,
          "maximum": 6,
          "minimum": 1,
          "title": "Tool Calls",
          "type": "integer"
        },
        "scientific_reservations": {
          "default": 2,
          "maximum": 2,
          "minimum": 1,
          "title": "Scientific Reservations",
          "type": "integer"
        },
        "active_seconds": {
          "default": 300,
          "maximum": 300,
          "minimum": 1,
          "title": "Active Seconds",
          "type": "integer"
        }
      },
      "title": "ResearchBudget",
      "type": "object"
    },
    "ResearchInteraction": {
      "additionalProperties": false,
      "properties": {
        "waiting_for_review": {
          "title": "Waiting For Review",
          "type": "boolean"
        },
        "waiting_for_observation": {
          "title": "Waiting For Observation",
          "type": "boolean"
        },
        "provider_consent_required": {
          "title": "Provider Consent Required",
          "type": "boolean"
        },
        "quota_exhausted": {
          "title": "Quota Exhausted",
          "type": "boolean"
        },
        "recovery": {
          "$ref": "#/$defs/ResearchRecovery"
        },
        "results": {
          "$ref": "#/$defs/ResearchResultAvailability"
        },
        "suggested_action": {
          "enum": [
            "reconcile",
            "inspect_accounting_or_cancel",
            "wait",
            "review",
            "review_observation",
            "inspect_results",
            "review_provider_consent",
            "inspect_allocation",
            "advance"
          ],
          "title": "Suggested Action",
          "type": "string"
        }
      },
      "required": [
        "waiting_for_review",
        "waiting_for_observation",
        "provider_consent_required",
        "quota_exhausted",
        "recovery",
        "results",
        "suggested_action"
      ],
      "title": "ResearchInteraction",
      "type": "object"
    },
    "ResearchProviderRemaining": {
      "additionalProperties": false,
      "properties": {
        "physical_requests": {
          "minimum": 0,
          "title": "Physical Requests",
          "type": "integer"
        },
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        }
      },
      "required": [
        "physical_requests",
        "input_tokens",
        "output_tokens"
      ],
      "title": "ResearchProviderRemaining",
      "type": "object"
    },
    "ResearchProviderUsage": {
      "additionalProperties": false,
      "properties": {
        "scope": {
          "const": "research_session",
          "title": "Scope",
          "type": "string"
        },
        "physical_requests": {
          "minimum": 0,
          "title": "Physical Requests",
          "type": "integer"
        },
        "reserved_input_tokens": {
          "minimum": 0,
          "title": "Reserved Input Tokens",
          "type": "integer"
        },
        "reserved_output_tokens": {
          "minimum": 0,
          "title": "Reserved Output Tokens",
          "type": "integer"
        },
        "accounted_input_tokens": {
          "minimum": 0,
          "title": "Accounted Input Tokens",
          "type": "integer"
        },
        "accounted_output_tokens": {
          "minimum": 0,
          "title": "Accounted Output Tokens",
          "type": "integer"
        },
        "reported_input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reported Input Tokens"
        },
        "reported_output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reported Output Tokens"
        },
        "reported_thought_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reported Thought Tokens"
        },
        "reported_total_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reported Total Tokens"
        },
        "reported_attempts": {
          "minimum": 0,
          "title": "Reported Attempts",
          "type": "integer"
        },
        "unresolved_attempts": {
          "minimum": 0,
          "title": "Unresolved Attempts",
          "type": "integer"
        },
        "accounting_valid": {
          "title": "Accounting Valid",
          "type": "boolean"
        },
        "remaining": {
          "$ref": "#/$defs/ResearchProviderRemaining"
        }
      },
      "required": [
        "scope",
        "physical_requests",
        "reserved_input_tokens",
        "reserved_output_tokens",
        "accounted_input_tokens",
        "accounted_output_tokens",
        "reported_input_tokens",
        "reported_output_tokens",
        "reported_thought_tokens",
        "reported_total_tokens",
        "reported_attempts",
        "unresolved_attempts",
        "accounting_valid",
        "remaining"
      ],
      "title": "ResearchProviderUsage",
      "type": "object"
    },
    "ResearchRecord": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Id",
          "type": "string"
        },
        "workspace_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Workspace Id",
          "type": "string"
        },
        "kind": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "body": {
          "additionalProperties": true,
          "title": "Body",
          "type": "object"
        },
        "digest": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "parent_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent Id"
        },
        "created_by": {
          "title": "Created By",
          "type": "string"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "id",
        "workspace_id",
        "kind",
        "body",
        "digest",
        "parent_id",
        "created_by",
        "created_at"
      ],
      "title": "ResearchRecord",
      "type": "object"
    },
    "ResearchRecovery": {
      "additionalProperties": false,
      "properties": {
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Code"
        },
        "can_reconcile": {
          "title": "Can Reconcile",
          "type": "boolean"
        },
        "next_action": {
          "enum": [
            "none",
            "reconcile",
            "inspect_accounting_or_cancel"
          ],
          "title": "Next Action",
          "type": "string"
        }
      },
      "required": [
        "required",
        "code",
        "can_reconcile",
        "next_action"
      ],
      "title": "ResearchRecovery",
      "type": "object"
    },
    "ResearchResultAvailability": {
      "additionalProperties": false,
      "properties": {
        "available": {
          "title": "Available",
          "type": "boolean"
        },
        "report_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "title": "Report Ids",
          "type": "array"
        },
        "latest_report_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Latest Report Id"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "download_job_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "title": "Download Job Ids",
          "type": "array"
        },
        "commentary_available": {
          "title": "Commentary Available",
          "type": "boolean"
        },
        "deterministic_summary_available": {
          "title": "Deterministic Summary Available",
          "type": "boolean"
        }
      },
      "required": [
        "available",
        "report_ids",
        "latest_report_id",
        "evidence_ids",
        "download_job_ids",
        "commentary_available",
        "deterministic_summary_available"
      ],
      "title": "ResearchResultAvailability",
      "type": "object"
    },
    "ResearchReviewedContext": {
      "additionalProperties": false,
      "properties": {
        "problem": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResearchRecord"
            },
            {
              "type": "null"
            }
          ]
        },
        "dataset": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResearchRecord"
            },
            {
              "type": "null"
            }
          ]
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/ResearchSourceRef"
          },
          "maxItems": 5,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "problem",
        "dataset",
        "sources"
      ],
      "title": "ResearchReviewedContext",
      "type": "object"
    },
    "ResearchSourceRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Id",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "id",
        "sha256"
      ],
      "title": "ResearchSourceRef",
      "type": "object"
    },
    "ResearchUsage": {
      "additionalProperties": false,
      "properties": {
        "logical_turns": {
          "minimum": 0,
          "title": "Logical Turns",
          "type": "integer"
        },
        "tool_calls": {
          "minimum": 0,
          "title": "Tool Calls",
          "type": "integer"
        },
        "child_count": {
          "minimum": 0,
          "title": "Child Count",
          "type": "integer"
        },
        "physical_calls": {
          "minimum": 0,
          "title": "Physical Calls",
          "type": "integer"
        }
      },
      "required": [
        "logical_turns",
        "tool_calls",
        "child_count",
        "physical_calls"
      ],
      "title": "ResearchUsage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "DB-RESEARCH-1",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Id",
      "type": "string"
    },
    "workspace_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Workspace Id",
      "type": "string"
    },
    "objective": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Objective",
      "type": "string"
    },
    "mode": {
      "enum": [
        "controlled",
        "live"
      ],
      "title": "Mode",
      "type": "string"
    },
    "state": {
      "enum": [
        "ready",
        "queued",
        "running",
        "waiting_review",
        "waiting_observation",
        "waiting_child",
        "paused",
        "needs_reconciliation",
        "completed",
        "failed",
        "cancelled"
      ],
      "title": "State",
      "type": "string"
    },
    "revision": {
      "minimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "problem_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Problem Id"
    },
    "problem_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Problem Digest"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/ResearchSourceRef"
      },
      "maxItems": 5,
      "title": "Sources",
      "type": "array"
    },
    "plan": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResearchRecord"
        },
        {
          "type": "null"
        }
      ]
    },
    "pending_review": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResearchRecord"
        },
        {
          "type": "null"
        }
      ]
    },
    "pending_review_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Pending Review Digest"
    },
    "action": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResearchActionSnapshot"
        },
        {
          "type": "null"
        }
      ]
    },
    "reviewed_context": {
      "$ref": "#/$defs/ResearchReviewedContext"
    },
    "children": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "maxItems": 4,
      "title": "Children",
      "type": "array"
    },
    "usage": {
      "$ref": "#/$defs/ResearchUsage"
    },
    "session_limits": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Session Limits",
      "type": "object"
    },
    "session_limits_policy": {
      "enum": [
        "research-session-limits.v1",
        "research-session-limits.v2"
      ],
      "title": "Session Limits Policy",
      "type": "string"
    },
    "graph_version": {
      "const": "research-graph.v1",
      "title": "Graph Version",
      "type": "string"
    },
    "checkpoint_version": {
      "const": "research-checkpoint.v1",
      "title": "Checkpoint Version",
      "type": "string"
    },
    "policy_version": {
      "const": "research-action.v1",
      "title": "Policy Version",
      "type": "string"
    },
    "reports": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
        "type": "string"
      },
      "title": "Reports",
      "type": "array"
    },
    "provider_disclosure": {
      "additionalProperties": true,
      "title": "Provider Disclosure",
      "type": "object"
    },
    "provider_allocation": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Provider Allocation",
      "type": "object"
    },
    "interaction": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResearchInteraction"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "provider_usage": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResearchProviderUsage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "id",
    "workspace_id",
    "objective",
    "mode",
    "state",
    "revision",
    "problem_id",
    "problem_digest",
    "sources",
    "plan",
    "pending_review",
    "pending_review_digest",
    "action",
    "reviewed_context",
    "children",
    "usage",
    "session_limits",
    "session_limits_policy",
    "graph_version",
    "checkpoint_version",
    "policy_version",
    "reports",
    "provider_disclosure",
    "provider_allocation",
    "created_at",
    "updated_at"
  ],
  "title": "ResearchSnapshot",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dr-bean:DB-RESEARCH-1:ResearchSnapshot"
}
