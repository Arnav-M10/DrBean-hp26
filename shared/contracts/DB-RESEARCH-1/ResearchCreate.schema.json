{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "DB-RESEARCH-1",
      "default": "DB-RESEARCH-1",
      "title": "Schema Version",
      "type": "string"
    },
    "objective": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Objective",
      "type": "string"
    },
    "problem_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Problem Id"
    },
    "expected_problem_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Problem Digest"
    },
    "source_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
        "type": "string"
      },
      "maxItems": 5,
      "title": "Source Ids",
      "type": "array"
    },
    "mode": {
      "default": "controlled",
      "enum": [
        "controlled",
        "live"
      ],
      "title": "Mode",
      "type": "string"
    },
    "provider_consent_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Consent Id"
    }
  },
  "required": [
    "objective"
  ],
  "title": "ResearchCreate",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dr-bean:DB-RESEARCH-1:ResearchCreate"
}
