{
  "$defs": {
    "AnalysisAssetRef": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "page_indices": {
          "anyOf": [
            {
              "items": {
                "maximum": 9,
                "minimum": 0,
                "type": "integer"
              },
              "maxItems": 10,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional zero-based pages to analyze (PDF). Omitted means every page.",
          "title": "Page Indices"
        }
      },
      "required": [
        "id",
        "sha256"
      ],
      "title": "AnalysisAssetRef",
      "type": "object"
    },
    "AnalysisConsent": {
      "additionalProperties": false,
      "properties": {
        "accepted": {
          "title": "Accepted",
          "type": "boolean"
        },
        "provider": {
          "const": "gemini",
          "title": "Provider",
          "type": "string"
        },
        "model": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "asset_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Asset Ids",
          "type": "array"
        },
        "include_question": {
          "title": "Include Question",
          "type": "boolean"
        }
      },
      "required": [
        "accepted",
        "provider",
        "model",
        "asset_ids",
        "include_question"
      ],
      "title": "AnalysisConsent",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "client_operation_id": {
      "title": "Client Operation Id",
      "type": "string"
    },
    "question": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Question",
      "type": "string"
    },
    "assets": {
      "items": {
        "$ref": "#/$defs/AnalysisAssetRef"
      },
      "maxItems": 5,
      "minItems": 1,
      "title": "Assets",
      "type": "array"
    },
    "consent": {
      "$ref": "#/$defs/AnalysisConsent"
    }
  },
  "required": [
    "client_operation_id",
    "question",
    "assets",
    "consent"
  ],
  "title": "ResearchAnalysisRequest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dr-bean:general-research.v1:ResearchAnalysisRequest"
}
