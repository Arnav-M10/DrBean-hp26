      "type": "string"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Model"
    },
    "estimated_input_tokens": {
      "title": "Estimated Input Tokens",
      "type": "integer"
    },
    "reserved_output_tokens": {
      "title": "Reserved Output Tokens",
      "type": "integer"
    },
    "max_input_tokens": {
      "title": "Max Input Tokens",
      "type": "integer"
    },
    "fits_context": {
      "title": "Fits Context",
      "type": "boolean"
    },
    "fits_budget": {
