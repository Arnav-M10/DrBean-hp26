        },
        "image_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Image Sha256"
        }
      },
      "required": [
        "page_index",
        "sent_as",
        "text_sha256",
        "image_sha256"
      ],
      "title": "SentPage",
      "type": "object"
    }
  },
  "additionalProperties": false,
