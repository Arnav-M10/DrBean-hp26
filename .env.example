# Local SQLite is the only qualified storage lane. Do not set DATABASE_URL.
BEAN_DATABASE_PATH=var/bean.sqlite3
BEAN_BLOB_DIR=var/sources
BEAN_AUTH_FILE=var/auth.json
BEAN_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Gemini is opt-in. See docs/HANDOFF.md for account and live qualification gates.
# Set credentials only in the server environment, never in browser code.
# GEMINI_API_KEY=
# GEMINI_MODEL=
# BEAN_GEMINI_ACCOUNT_GATE=approved
# BEAN_GEMINI_ACCOUNT_DECISION_ID=
# BEAN_GEMINI_IMAGE_TOKEN_BOUND=
# BEAN_GEMINI_MAX_INPUT_TOKENS=16000
# BEAN_GEMINI_MAX_OUTPUT_TOKENS=2048

# Optional, release checks only (scripts/release/checklist.py): base URL of a running backend.
# DRBEAN_API_BASE=http://127.0.0.1:8000

# AI mode for this sprint. scripts/dev/start.sh always sets "placeholder" and removes the
# GEMINI_* and BEAN_GEMINI_* variables above from the processes it starts, so a key in your
# shell cannot enable a live call. Going live needs a new explicit team decision first.
# BEAN_AI_MODE=placeholder
