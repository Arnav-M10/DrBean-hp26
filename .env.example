# Local SQLite is the only qualified storage lane. Do not set DATABASE_URL.
BEAN_DATABASE_PATH=var/bean.sqlite3
BEAN_BLOB_DIR=var/sources
BEAN_ARTIFACT_DIR=var/artifacts
BEAN_AUTH_FILE=var/auth.json
BEAN_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# API and worker must share the same database, storage and server-owned runtime.
# Backend remains Python 3.12/3.13; the bundled Counterdex engine requires 3.11.
BEAN_SCIENCE_ADAPTER=counterdex
BEAN_COUNTERDEX_PYTHON=python3.11

# Model dispatch is disabled by default. The launcher discards shell provider credentials.
# For explicit local live opt-in, copy scripts/dev/gemini.local.example.json to
# var/gemini.local.json, chmod it to 600, and complete the private configuration.
# See README.md, Optional live Gemini. Never commit an actual key.

# Optional, release checks only (scripts/release/checklist.py): base URL of a running backend.
# DRBEAN_API_BASE=http://127.0.0.1:8000

# Without that private opt-in, scripts/dev/start.sh uses placeholder mode and strips
# provider credentials. Only API and worker receive an admitted live configuration;
# the web process remains sanitized. An API key in the shell alone enables nothing.
# BEAN_AI_MODE=placeholder
