# Names only. Never commit values. Provider secrets stay out of source and out of the frontend.
# The deterministic manual flow must work with all of these unset.

# Read by the backend's Gemini provider layer (Owner 02), never by the browser or the harness.
GEMINI_API_KEY=
# Pinned model id chosen from actual account availability at qualification time.
GEMINI_MODEL=

# Optional: base URL of a running backend for release checks (scripts/release/checklist.py).
DRBEAN_API_BASE=
