      "boundary": "baseline layout; empty draft",
      "controlled": {
        "provider_script": [
          {
            "kind": "structured_proposals",
            "transcribes": "c01a"
          }
        ]
      },
      "expected": [
        {
          "axis": "outcome",
          "id": "C01A-1",
          "path": "state",
          "type": "eq",
          "value": "review_ready",
          "why": "a readable complete source yields a reviewable proposal set"
        },
        {
          "axis": "outcome",
          "id": "C01A-2",
          "path": "proposals[field=target_min].value",
          "type": "eq",
          "value": "1/10",
          "why": "target lower bound transcribed exactly"
        },
        {
          "axis": "outcome",
          "id": "C01A-3",
          "path": "proposals[field=target_max].value",
          "type": "eq",
          "value": "17/100",
          "why": "target upper bound transcribed exactly"
