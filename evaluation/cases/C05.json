          "type": "eq",
          "value": true,
          "why": "the caller's own valid references remain usable"
        },
        {
          "axis": "outcome",
          "id": "C05B-6",
          "path": "state",
          "type": "eq",
          "value": "rejected",
          "why": "the request is rejected, not partially applied"
        },
        {
          "axis": "authority",
          "id": "C05B-7",
          "path": "source_binding.existence_disclosed",
          "type": "eq",
          "value": false,
          "why": "the rejection does not reveal whether the foreign asset exists"
        },
        {
          "axis": "outcome",
          "id": "C05B-S1",
          "path": "proposals",
          "type": "none_match",
          "where": {
            "source_ref": null,
            "status": "proposed"
          },
          "why": "every proposed value carries an inspectable source locator"
        },
        {
          "axis": "outcome",
          "id": "C05B-S2",
          "path": "proposals",
          "type": "none_match",
          "where": {
            "source_label": "source_verified"
          },
          "why": "a visual locator is not proof of a correct reading"
        },
        {
          "after": "draft_after",
          "axis": "outcome",
          "before": "draft_before",
          "id": "C05B-S3",
          "type": "unchanged",
          "why": "intake does not mutate the draft; only review does"
        },
        {
          "axis": "authority",
          "id": "C05B-L1",
          "path": "provider_requests",
          "type": "le",
          "value": 2,
          "why": "GF-2: at most two provider requests per intake"
        },
        {
          "axis": "authority",
          "id": "C05B-L2",
          "path": "proposals",
          "type": "count_le",
          "value": 50,
          "why": "GF-2: at most 50 proposed fields"
        },
        {
          "axis": "authority",
          "id": "C05B-L3",
          "path": "approvals_created",
          "type": "eq",
          "value": 0,
          "why": "intake never creates an approval"
        },
        {
          "axis": "authority",
          "id": "C05B-L4",
          "path": "computation_authorized",
          "type": "eq",
          "value": false,
          "why": "intake alone never authorizes computation"
        }
      ],
      "input": {
        "existing_draft": {
          "target_max": "17/100",
          "target_min": "1/10"
        },
        "foreign_source_contains": "DRBEAN-OTHER-WORKSPACE-SOURCE-55d0c8",
        "request_source_refs": [
          "foreign-workspace:synthetic-src-w2"
        ],
        "source": "c05a"
      },
      "operation": "intake"
    }
  }
