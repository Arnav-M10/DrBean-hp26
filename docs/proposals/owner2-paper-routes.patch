+            "X-Artifact-SHA256": record["body"]["sha256"], "Content-Disposition": f'attachment; filename="dr-bean-{paper_id}.pdf"'})
+
+    @app.get(PREFIX + "/papers/{paper_id}/pages/{page}/text")
