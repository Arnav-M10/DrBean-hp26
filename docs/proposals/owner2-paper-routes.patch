+    async def paper_page_preview(paper_id: str, page: int, actor: Actor, scale: float = Query(1.5, gt=0, le=3)):
+        from starlette.concurrency import run_in_threadpool
+        rendered = await run_in_threadpool(papers.page_preview, actor, paper_id, page, scale)
+        meta = rendered["preview"]
+        return Response(rendered["png"], media_type="image/png", headers={
+            "X-Artifact-SHA256": meta["png_sha256"], "X-Preview-Scale": meta["scale"], "Content-Disposition": "inline"})
+
+    @app.post(PREFIX + "/papers/{paper_id}/page-selections", status_code=201)
+    async def paper_selection(paper_id: str, body: dict, actor: Actor, key: OperationKey):
